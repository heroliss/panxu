<?xml version="1.0" encoding="utf-8"?>
<!--
  Shipped next to PanXu.exe (build.ps1 copies it).

  A zip downloaded with a browser carries the "from the internet" mark, and Windows passes it on to every
  file extracted from it. The .NET Framework then refuses to load such a DLL from disk, so the window could
  not start: "Failed to resolve Python.Runtime.Loader.Initialize ... Python.Runtime.dll".
  These are the program's own files in its own folder; this tells .NET to load them as usual. It does not
  remove the mark from any file and changes no system setting.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
